# ─────────────────────────────────────────────────────────────────────────────
# VARIABLES DE ENTORNO — ELI server
#
# INSTRUCCIÓN IMPORTANTE:
#   Este archivo (.env.example) SÍ va a control de versiones como plantilla.
#   El archivo .env real con los valores reales NUNCA debe commitearse.
#   El .gitignore de este directorio ya excluye .env.
#
# Para empezar: copia este archivo a .env y rellena los valores.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# API key que la app móvil incluye en cada petición (header X-ELI-API-KEY).
# Genera un valor seguro con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ELI_API_KEY=cambia_esto_en_produccion

# API key del panel de administración (header X-ELI-ADMIN-KEY).
# DEBE SER DIFERENTE de ELI_API_KEY.
# Genera con el mismo comando de arriba.
ADMIN_API_KEY=cambia_esto_en_produccion_diferente_de_la_anterior

# Origen CORS permitido: URL exacta desde la que la app llama a este servidor.
# En producción nunca usar '*'.
ALLOWED_ORIGIN=https://eli-app.org

# Puerto TCP en el que escucha el servidor Express.
PORT=3000

# Ruta al archivo SQLite (relativa al directorio server/).
# El directorio se crea automáticamente si no existe.
DB_PATH=./data/eli.db
